# Copy to frontend/.env  (Vite exposes every VITE_* value to the browser, so NEVER put secrets here.)
# Firebase web config is public by design. Find it in Firebase console > Project settings > Your apps.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Backend URL, including the /api prefix
VITE_API_URL=http://localhost:8000/api
