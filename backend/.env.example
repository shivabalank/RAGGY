# Copy this file to backend/.env and fill in the blanks.  NEVER commit backend/.env.

# ---------- App ----------
ENVIRONMENT=development
# Browser origin(s) allowed to call this API (comma-separated). Add your Vercel URL when you deploy.
FRONTEND_URL=http://localhost:5173
MAX_FILE_MB=25

# ---------- PostgreSQL (matches docker-compose.yml) ----------
DATABASE_URL=postgresql+psycopg://raggy:raggy@localhost:5432/raggy

# ---------- File storage ----------
# local = save uploads on this computer (no AWS needed - fine for learning/dev)
# s3    = Amazon S3 (use this in production; fill the AWS_* values below)
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=

# ---------- Qdrant vector database (matches docker-compose.yml) ----------
# Leave QDRANT_URL empty to use an embedded local database in ./qdrant_data instead of Docker.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=document_assistant

# ---------- Firebase (only the project id is required to verify sign-ins) ----------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ---------- Hugging Face + Llama 2 ----------
HF_TOKEN=
LLAMA_MODEL_ID=meta-llama/Llama-2-7b-chat-hf
# local  = run Llama inside this backend (needs an NVIDIA GPU)
# remote = call a GPU server (backend/llm_server.py, vLLM, HF Inference Endpoint, ...) at LLM_REMOTE_URL
LLM_PROVIDER=remote
LLM_REMOTE_URL=
LLM_REMOTE_API_KEY=
USE_4BIT=true
MAX_NEW_TOKENS=300
TEMPERATURE=0.2
WARMUP_LLM=false

# ---------- RAG tuning (defaults come from your notebook) ----------
EMBEDDING_MODEL_ID=BAAI/bge-small-en-v1.5
RERANKER_MODEL_ID=cross-encoder/ms-marco-MiniLM-L-6-v2
USE_RERANKER=true
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5
RERANK_CANDIDATES=15
RELEVANCE_THRESHOLD=0.35
